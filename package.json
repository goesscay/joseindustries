{
  "name": "jose-industries-app",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Node.js/Express (TypeScript) + React app with MySQL",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:server": "cross-env PORT=3000 tsx watch src/index.ts",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm install --prefix client && npm run build --prefix client",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "postinstall": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-admin": "tsx src/db/seedAdmin.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "hostinger-api-sdk": "^1.23.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pdfkit": "^0.13.4",
    "@types/node": "^20.14.9",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
