PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jose_industries

# Secret used to sign auth session JWTs - use a long random string, different per environment
JWT_SECRET=

# Optional: only used by `npm run db:seed-admin` to bootstrap the first super_admin account
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Company details printed on generated PDFs live in the `companies` table
# (seeded via `npm run db:seed-companies`, editable from the Companies page) -
# not env vars, since documents are raised under one of several companies.

# Hostinger API token (hPanel -> Account -> API), used by hostinger-api-sdk
HOSTINGER_API_TOKEN=

# Cloudflare API token (Zone:DNS:Edit) and zone ID for joseindustries.in, used for DNS scripting
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
